<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Label="UserMacros">
    <ExternalDir>$(SolutionDir)..\External\</ExternalDir>
    <ImGuiDir>$(ExternalDir)imgui\</ImGuiDir>
    <AssimpDir>$(ExternalDir)assimp\</AssimpDir>

    <!-- NoesisGUI is not in the repository. Set NOESIS_SDK to the SDK root, or extract it to the default below. -->
    <NoesisSDKDir Condition="'$(NoesisSDKDir)' == '' And '$(NOESIS_SDK)' != ''">$(NOESIS_SDK)\</NoesisSDKDir>
    <NoesisSDKDir Condition="'$(NoesisSDKDir)' == ''">$(ExternalDir)NoesisGUI-NativeSDK-win-4.0.1-Indie\</NoesisSDKDir>
    <NoesisPackages>$(NoesisSDKDir)Src\Packages\</NoesisPackages>
    <NoesisIncludes>$(NoesisSDKDir)Include;$(NoesisPackages)Render\VKRenderDevice\Include;$(NoesisPackages)Render\D3D12RenderDevice\Include;$(NoesisPackages)Render\RenderContext\Include;$(NoesisPackages)App\Interactivity\Include;$(NoesisPackages)App\Shaders\Include;$(NoesisPackages)App\Providers\Include;$(NoesisPackages)App\Launcher\Include;$(NoesisPackages)App\Display\Include</NoesisIncludes>
    <NoesisLibs>$(NoesisSDKDir)Lib\windows_x86_64\Noesis.lib;$(NoesisSDKDir)Lib\windows_x86_64\NoesisApp.lib</NoesisLibs>
  </PropertyGroup>
  <PropertyGroup>
    <OutDir>$(SolutionDir)$(Platform)\$(Configuration)\</OutDir>
    <IntDir>$(ProjectDir)$(Platform)\$(Configuration)\$(ProjectName)\</IntDir>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>Level3</WarningLevel>
      <SDLCheck>true</SDLCheck>
      <ConformanceMode>true</ConformanceMode>
      <LanguageStandard>stdcpp23</LanguageStandard>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
      <DisableSpecificWarnings>4251;%(DisableSpecificWarnings)</DisableSpecificWarnings>
      <AdditionalIncludeDirectories>$(VULKAN_SDK)\Include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <SubSystem>Console</SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
    </Link>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)' == 'Debug'">
    <ClCompile>
      <Optimization>Disabled</Optimization>
      <PreprocessorDefinitions>_DEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)' == 'Release'">
    <ClCompile>
      <Optimization>MaxSpeed</Optimization>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <PreprocessorDefinitions>NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <OptimizeReferences>true</OptimizeReferences>
    </Link>
  </ItemDefinitionGroup>
</Project>
